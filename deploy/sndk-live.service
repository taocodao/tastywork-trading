[Unit]
Description=SNDK Naked Options Live Trading Bot
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tastywork-trading
ExecStart=/usr/bin/python3 run_sndk_live.py
Restart=always
RestartSec=30
StandardOutput=append:/home/ubuntu/tastywork-trading/logs/sndk_live.log
StandardError=append:/home/ubuntu/tastywork-trading/logs/sndk_live.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
