[Unit]
Description=TradeMind ZEBRA Strategy Monitor
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tastywork-trading
Environment="PYTHONPATH=/home/ubuntu/tastywork-trading"
ExecStart=/usr/bin/python3 src/zebra/monitor.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
