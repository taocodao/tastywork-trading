[Unit]
Description=Calendar Spread Continuous Monitoring Service
After=network.target
After=docker.service
Wants=docker.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/tastywork-trading
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 /home/ubuntu/tastywork-trading/calendar_monitor_continuous.py
Restart=always
RestartSec=10
StandardOutput=append:/home/ubuntu/tastywork-trading/calendar_monitor.log
StandardError=append:/home/ubuntu/tastywork-trading/calendar_monitor_error.log

# Resource limits
LimitNOFILE=65536
MemoryMax=1G

# Watchdog (restart if no activity for 10 minutes)
WatchdogSec=600

[Install]
WantedBy=multi-user.target
